<file path="core/events.js">
// Global event bus.
// const unsubscribe = events.on('death', () => {});

class EventEmitter {
  constructor() {
    this.listeners = new Map();
  }

  on(event, callback) {
    if (!this.listeners.has(event)) {
      this.listeners.set(event, []);
    }
    this.listeners.get(event).push(callback);
    return () => this.off(event, callback);
  }

  off(event, callback) {
    if (!this.listeners.has(event)) return;
    const callbacks = this.listeners.get(event).filter(cb => cb !== callback);
    this.listeners.set(event, callbacks);
  }

  emit(event, data) {
    if (!this.listeners.has(event)) return;
    const callbacks = [...this.listeners.get(event)];
    for (const callback of callbacks) {
      callback(data);
    }
  }
}

export const events = new EventEmitter();
</file>

<file path="core/input.js">
// Maps physical keyboard and mouse inputs to logical game actions.

class InputManager {
  constructor() {
    this.bindings = new Map();
    this.state = new Map();
    this.prevState = new Map();
    this.mouse = { x: 0, y: 0 };
    this.targetElement = document.body;

    window.addEventListener('keydown', (e) => this.state.set(e.code, true));
    window.addEventListener('keyup', (e) => this.state.set(e.code, false));
    window.addEventListener('mousedown', (e) => this.state.set(`Mouse${e.button}`, true));
    window.addEventListener('mouseup', (e) => this.state.set(`Mouse${e.button}`, false));
    
    window.addEventListener('blur', () => {
      this.state.clear();
      this.prevState.clear();
    });

    window.addEventListener('mousemove', (e) => {
      const rect = this.targetElement.getBoundingClientRect();
      this.mouse.x = e.clientX - rect.left;
      this.mouse.y = e.clientY - rect.top;
    });
  }

  setTarget(element) {
    this.targetElement = element;
  }

  bind(action, keys) {
    this.bindings.set(action, Array.isArray(keys) ? keys : [keys]);
  }

  isDown(action) {
    const keys = this.bindings.get(action) || [];
    return keys.some(key => this.state.get(key));
  }

  isPressed(action) {
    const keys = this.bindings.get(action) || [];
    return keys.some(key => this.state.get(key) && !this.prevState.get(key));
  }

  isReleased(action) {
    const keys = this.bindings.get(action) || [];
    return keys.some(key => !this.state.get(key) && this.prevState.get(key));
  }

  update() {
    this.prevState.clear();
    for (const [key, value] of this.state) {
      this.prevState.set(key, value);
    }
  }
}

export const input = new InputManager();
</file>

<file path="core/loop.js">
// Fixed-timestep game loop for stable physics and framerate-independent updates.
// const loop = new GameLoop((dt) => update(dt), () => render());
// loop.start();
// console.log(loop.fps);

export class GameLoop {
  constructor(updateFn, renderFn, targetFps = 60) {
    this.updateFn = updateFn;
    this.renderFn = renderFn;
    this.step = 1000 / targetFps;
    this.lastTime = 0;
    this.accumulator = 0;
    this.rafId = null;
    this.isRunning = false;

    this.fps = 0;
    this._frameCount = 0;
    this._lastFpsTime = 0;
  }

  start() {
    if (this.isRunning) return;
    this.isRunning = true;
    const now = performance.now();
    this.lastTime = now;
    this._lastFpsTime = now;
    this._frameCount = 0;
    this.rafId = requestAnimationFrame((time) => this.frame(time));
  }

  stop() {
    this.isRunning = false;
    cancelAnimationFrame(this.rafId);
  }

  frame(currentTime) {
    if (!this.isRunning) return;

    let deltaTime = currentTime - this.lastTime;
    this.lastTime = currentTime;

    if (deltaTime > 250) {
      deltaTime = 250;
    }

    this.accumulator += deltaTime;

    while (this.accumulator >= this.step) {
      this.updateFn(this.step);
      this.accumulator -= this.step;
    }

    this.renderFn();

    this._frameCount++;
    if (currentTime - this._lastFpsTime >= 1000) {
      this.fps = this._frameCount;
      this._frameCount = 0;
      this._lastFpsTime = currentTime;
    }

    this.rafId = requestAnimationFrame((time) => this.frame(time));
  }
}
</file>

<file path="core/timer.js">
// Handles in-game delays, cooldowns, and repeating intervals based on delta time.

class TimerManager {
  constructor() {
    this.timers = [];
  }

  add(durationMs, onComplete, onUpdate = null) {
    const timer = { duration: durationMs, elapsed: 0, onComplete, onUpdate, isEvery: false, marked: false };
    this.timers.push(timer);
    return timer;
  }

  every(durationMs, onTick) {
    const timer = { duration: durationMs, elapsed: 0, onComplete: onTick, isEvery: true, marked: false };
    this.timers.push(timer);
    return timer;
  }

  cancel(timerRef) {
    if (timerRef) timerRef.marked = true;
  }

  update(dt) {
    const active = [];

    for (const t of this.timers) {
      if (t.marked) continue;

      t.elapsed += dt;
      
      if (t.onUpdate) {
        t.onUpdate(Math.min(t.elapsed / t.duration, 1));
      }

      if (t.elapsed >= t.duration) {
        if (t.onComplete) t.onComplete();
        
        if (t.isEvery && !t.marked) {
          t.elapsed -= t.duration;
          active.push(t);
        }
      } else {
        active.push(t);
      }
    }

    this.timers = active;
  }
}

export const timer = new TimerManager();
</file>

