<file path="index.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GameKit — Modular 2D Web Game Toolkit</title>
  <link rel="stylesheet" href="/demo/module-docs.css">
</head>
<body class="gk-doc-page">
  <header class="gk-topbar">
    <div class="gk-topbar-inner">
      <a href="/" class="gk-brand">GameKit <span>v0.2.0</span></a>
      <nav class="gk-pill-nav">
        <a href="/" class="active">Modules (32)</a>
        <a href="/demo/showcase/swarm-demo.html">32-Module Swarm Showcase</a>
        <a href="/about.html">About Me</a>
      </nav>
    </div>
  </header>

  <main class="gk-container gk-fade-in">
    <section class="gk-showcase-banner">
      <div class="gk-showcase-banner-text">
        <span class="gk-badge-amber">Full Integration Demo</span>
        <h1>32-Module Swarm Survival Showcase</h1>
        <p>Playable top-down arena combining all 32 Core, Gameplay, AI, World, and UI modules in a single 60Hz loop.</p>
      </div>
      <div class="gk-showcase-banner-actions">
        <a href="/demo/showcase/swarm-demo.html" class="gk-cta-btn">Launch Swarm Showcase →</a>
      </div>
    </section>

    <section class="gk-hub-controls">
      <div class="gk-filter-pills" id="categoryPills">
        <button type="button" class="active" data-cat="all">All <span>32</span></button>
        <button type="button" data-cat="core">Core <span>8</span></button>
        <button type="button" data-cat="gameplay">Gameplay <span>13</span></button>
        <button type="button" data-cat="ai">AI <span>4</span></button>
        <button type="button" data-cat="world">World <span>3</span></button>
        <button type="button" data-cat="ui">UI <span>4</span></button>
      </div>
      <input type="search" id="moduleSearch" class="gk-search-input" placeholder="Filter modules by name or description..." autocomplete="off">
    </section>

    <div id="moduleListMount" class="gk-module-groups"></div>
  </main>

  <script type="module">
    import { MODULE_CATALOG, CATEGORY_META, downloadModuleFile } from '/demo/module-docs.js';

    const mount = document.getElementById('moduleListMount');
    const searchInput = document.getElementById('moduleSearch');
    const pills = document.querySelectorAll('#categoryPills button');
    let activeCategory = 'all';

    function renderList() {
      const query = searchInput.value.trim().toLowerCase();
      mount.innerHTML = '';

      const categories = ['core', 'gameplay', 'ai', 'world', 'ui'];
      let totalShown = 0;

      for (const cat of categories) {
        if (activeCategory !== 'all' && activeCategory !== cat) continue;

        const items = MODULE_CATALOG.filter((m) => {
          if (m.category !== cat) return false;
          if (!query) return true;
          return (
            m.title.toLowerCase().includes(query) ||
            m.exportName.toLowerCase().includes(query) ||
            m.file.toLowerCase().includes(query) ||
            m.summary.toLowerCase().includes(query)
          );
        });

        if (items.length === 0) continue;
        totalShown += items.length;

        const meta = CATEGORY_META[cat];
        const group = document.createElement('section');
        group.className = 'gk-list-group';
        group.innerHTML = `
          <div class="gk-list-group-head">
            <div class="gk-list-group-title">
              <h2>${meta.label}</h2>
              <span class="gk-list-count">${items.length}</span>
            </div>
            <p>${meta.tagline}</p>
          </div>
          <div class="gk-list-rows">
            ${items.map((m) => {
              const filename = m.file.split('/').pop();
              return `
                <a href="${m.demoPath}" class="gk-list-row">
                  <div class="gk-list-row-left">
                    <span class="gk-list-name">${m.title}</span>
                    <code class="gk-list-path">${m.file}</code>
                  </div>
                  <p class="gk-list-desc">${m.summary}</p>
                  <div class="gk-list-row-actions">
                    <button type="button" class="gk-download-btn" data-download="${m.file}" title="Download ${m.file}">
                      ↓ ${filename}
                    </button>
                    <span class="gk-list-arrow" aria-hidden="true">→</span>
                  </div>
                </a>
              `;
            }).join('')}
          </div>
        `;
        mount.appendChild(group);
      }

      mount.querySelectorAll('[data-download]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          downloadModuleFile(btn.dataset.download);
        });
      });

      if (totalShown === 0) {
        mount.innerHTML = `<div class="gk-empty-state">No modules match "${searchInput.value}".</div>`;
      }
    }

    pills.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.cat;
        pills.forEach((b) => b.classList.toggle('active', b === btn));
        renderList();
      });
    });

    searchInput.addEventListener('input', renderList);
    renderList();
  </script>
</body>
</html>
