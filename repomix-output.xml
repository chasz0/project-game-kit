<file path="demo/gameplay/js/camera-demo.js">
import { Camera } from '@gameplay/camera.js';
import { input } from '@core/input.js';

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

const cam = new Camera(canvas.width, canvas.height);
const mouseScreen = { x: canvas.width / 2, y: canvas.height / 2 };
const target = { x: 200, y: 150 };

document.getElementById('shakeBtn').addEventListener('click', () => {
  cam.shake(300, 15);
});

document.getElementById('zoomInBtn').addEventListener('click', () => {
  cam.setZoom(cam.zoom + 0.25);
});

document.getElementById('zoomOutBtn').addEventListener('click', () => {
  cam.setZoom(cam.zoom - 0.25);
});

canvas.addEventListener('mousemove', () => {
  mouseScreen.x = input.mouse.x;
  mouseScreen.y = input.mouse.y;
});

let lastTime = performance.now();

const drawGrid = () => {
  ctx.strokeStyle = '#333';
  ctx.lineWidth = 1;
  for (let x = -500; x < 1000; x += 50) {
    ctx.beginPath(); ctx.moveTo(x, -500); ctx.lineTo(x, 1000); ctx.stroke();
  }
  for (let y = -500; y < 1000; y += 50) {
    ctx.beginPath(); ctx.moveTo(-500, y); ctx.lineTo(1000, y); ctx.stroke();
  }
};

const loop = (time) => {
  const dt = time - lastTime;
  lastTime = time;

  cam.screenToWorld(mouseScreen.x, mouseScreen.y, target);
  cam.follow(target, 0.08, dt);
  cam.update(dt);

  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  cam.apply(ctx);
  drawGrid();

  ctx.fillStyle = '#00ffcc';
  ctx.beginPath();
  ctx.arc(target.x, target.y, 10, 0, Math.PI * 2);
  ctx.fill();

  requestAnimationFrame(loop);
};

requestAnimationFrame(loop);
</file>

<file path="demo/gameplay/js/collision-demo.js">
import { collision } from '@gameplay/collision.js';
import { input } from '@core/input.js';

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const out = document.getElementById('output');

const wall = { x: 220, y: 140, w: 160, h: 120 };
const pillar = { x: 100, y: 200, r: 45 };
const triggerBox = { x: 450, y: 60, w: 90, h: 90 };

const cursor = { x: 300, y: 80, r: 28, w: 56, h: 56, asBox: false };
const manifold = { nx: 0, ny: 0, depth: 0 };

const bodies = Array.from({ length: 25 }, (_, i) => ({
  x: 260 + (i % 5) * 22,
  y: 40 + Math.floor(i / 5) * 22,
  r: 12,
}));

canvas.addEventListener('mousemove', () => {
  cursor.x = input.mouse.x;
  cursor.y = input.mouse.y;
});

canvas.addEventListener('click', () => {
  cursor.asBox = !cursor.asBox;
});

const getCursorObstacleHit = (cursorBox) => {
  if (!cursor.asBox) {
    return (
      collision.circleBoxInfo(cursor, wall, manifold) ||
      collision.circleCircleInfo(cursor, pillar, manifold)
    );
  }

  const wallHit = collision.boxBoxInfo(cursorBox, wall, manifold);
  if (wallHit) return wallHit;

  // circleBoxInfo pushes the circle out of the box; negate normal to push the box out of the pillar
  const pillarHit = collision.circleBoxInfo(pillar, cursorBox, manifold);
  if (pillarHit) {
    pillarHit.nx = -pillarHit.nx;
    pillarHit.ny = -pillarHit.ny;
    return pillarHit;
  }
  return null;
};

const loop = () => {
  let activeContacts = 0;
  const cursorBox = {
    x: cursor.x - cursor.w / 2,
    y: cursor.y - cursor.h / 2,
    w: cursor.w,
    h: cursor.h
  };

  for (let i = 0; i < bodies.length; i++) {
    const a = bodies[i];

    const hitCursor = cursor.asBox
      ? collision.circleBoxInfo(a, cursorBox, manifold)
      : collision.circleCircleInfo(a, cursor, manifold);

    if (hitCursor) {
      a.x += hitCursor.nx * hitCursor.depth;
      a.y += hitCursor.ny * hitCursor.depth;
      activeContacts++;
    }

    for (let j = i + 1; j < bodies.length; j++) {
      const b = bodies[j];
      const hit = collision.circleCircleInfo(a, b, manifold);
      if (hit) {
        const half = hit.depth * 0.5;
        a.x += hit.nx * half;
        a.y += hit.ny * half;
        b.x -= hit.nx * half;
        b.y -= hit.ny * half;
        activeContacts++;
      }
    }

    const hitWall = collision.circleBoxInfo(a, wall, manifold);
    if (hitWall) {
      a.x += hitWall.nx * hitWall.depth;
      a.y += hitWall.ny * hitWall.depth;
    }

    const hitPillar = collision.circleCircleInfo(a, pillar, manifold);
    if (hitPillar) {
      a.x += hitPillar.nx * hitPillar.depth;
      a.y += hitPillar.ny * hitPillar.depth;
    }
  }

  const inTrigger = cursor.asBox
    ? collision.boxBox(cursorBox, triggerBox)
    : collision.circleBox(cursor, triggerBox);

  const obstacleHit = getCursorObstacleHit(cursorBox);

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.strokeStyle = inTrigger ? '#ff3366' : '#555';
  ctx.strokeRect(triggerBox.x, triggerBox.y, triggerBox.w, triggerBox.h);

  ctx.fillStyle = '#2a2a2a';
  ctx.fillRect(wall.x, wall.y, wall.w, wall.h);
  ctx.beginPath();
  ctx.arc(pillar.x, pillar.y, pillar.r, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = '#00ffcc';
  for (const b of bodies) {
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.r - 1, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.strokeStyle = obstacleHit || inTrigger ? '#ff3366' : '#fff';
  ctx.lineWidth = 2;
  if (cursor.asBox) {
    ctx.strokeRect(cursorBox.x, cursorBox.y, cursorBox.w, cursorBox.h);
  } else {
    ctx.beginPath();
    ctx.arc(cursor.x, cursor.y, cursor.r, 0, Math.PI * 2);
    ctx.stroke();
  }

  if (obstacleHit) {
    ctx.strokeStyle = '#00ffcc';
    ctx.setLineDash([4, 4]);
    const pushX = obstacleHit.nx * obstacleHit.depth;
    const pushY = obstacleHit.ny * obstacleHit.depth;

    if (cursor.asBox) {
      ctx.strokeRect(cursorBox.x + pushX, cursorBox.y + pushY, cursor.w, cursor.h);
    } else {
      ctx.beginPath();
      ctx.arc(cursor.x + pushX, cursor.y + pushY, cursor.r, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.setLineDash([]);
  }

  out.textContent =
    `Cursor Shape: ${cursor.asBox ? 'Box' : 'Circle'} (Click to switch)\n` +
    `Trigger Zone Overlap: ${inTrigger}\n` +
    `Swarm Contacts Resolved This Frame: ${activeContacts}\n` +
    (obstacleHit
      ? `Obstacle Penetration: depth=${obstacleHit.depth.toFixed(1)}px, normal=(${obstacleHit.nx.toFixed(2)}, ${obstacleHit.ny.toFixed(2)})`
      : `Obstacle Penetration: none`);

  requestAnimationFrame(loop);
};

requestAnimationFrame(loop);
</file>

<file path="demo/gameplay/js/spatialHash-demo.js">
import { SpatialHash } from '@gameplay/spatialHash.js';
import { input } from '@core/input.js';

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const out = document.getElementById('output');

const WORLD_W = canvas.width;
const WORLD_H = canvas.height;
const CELL_SIZE = 40;
const ENTITY_COUNT = 5000;
const QUERY_RADIUS = 50;

const grid = new SpatialHash(CELL_SIZE);
const entities = [];
const nearby = [];
const mouse = { x: WORLD_W / 2, y: WORLD_H / 2 };

for (let i = 0; i < ENTITY_COUNT; i++) {
  const entity = {
    x: Math.random() * WORLD_W,
    y: Math.random() * WORLD_H,
    vx: (Math.random() - 0.5) * 1.5,
    vy: (Math.random() - 0.5) * 1.5,
    r: 2,
  };
  entities.push(entity);
  grid.insert(entity);
}

canvas.addEventListener('mousemove', () => {
  mouse.x = input.mouse.x;
  mouse.y = input.mouse.y;
});

const loop = () => {
  let cellTransfers = 0;

  const t0 = performance.now();
  for (let i = 0; i < entities.length; i++) {
    const e = entities[i];
    e.x += e.vx;
    e.y += e.vy;

    if (e.x < 0 || e.x > WORLD_W) e.vx *= -1;
    if (e.y < 0 || e.y > WORLD_H) e.vy *= -1;

    if (grid.update(e)) cellTransfers++;
  }
  const updateMs = performance.now() - t0;

  const t1 = performance.now();
  grid.queryRadius(mouse.x, mouse.y, QUERY_RADIUS, nearby);
  const queryMs = performance.now() - t1;

  ctx.clearRect(0, 0, WORLD_W, WORLD_H);

  ctx.fillStyle = '#444';
  for (let i = 0; i < entities.length; i++) {
    const e = entities[i];
    ctx.fillRect(e.x - 1, e.y - 1, 2, 2);
  }

  ctx.fillStyle = '#00ffcc';
  for (let i = 0; i < nearby.length; i++) {
    const e = nearby[i];
    ctx.fillRect(e.x - 2, e.y - 2, 4, 4);
  }

  ctx.strokeStyle = '#00ffcc';
  ctx.strokeRect(
    mouse.x - QUERY_RADIUS,
    mouse.y - QUERY_RADIUS,
    QUERY_RADIUS * 2,
    QUERY_RADIUS * 2
  );

  const skipped = ENTITY_COUNT - cellTransfers;
  out.textContent =
    `Entities: ${ grid.size } | Active Cells: ${ grid.cellCount }\n` +
    `Update(5000): ${ updateMs.toFixed(2) } ms | Cell transfers: ${ cellTransfers } | Early-exit skipped: ${ skipped }\n` +
    `Query candidates: ${ nearby.length } (${ queryMs.toFixed(3) } ms, 0 allocations)`;

  requestAnimationFrame(loop);
};

requestAnimationFrame(loop);
