// Autonomous agent steering behaviors and force integration.
// Agent shape: { x, y, vx, vy }
//
//   const force = steering.flee(enemy, player, enemy.maxSpeed, 160);
//   steering.applyForce(enemy, force, enemy.maxForce, enemy.maxSpeed, dt);

const _targetScratch = { x: 0, y: 0 };

const clampVec = (out, maxLen) => {
  const mSq = out.x * out.x + out.y * out.y;
  if (mSq > maxLen * maxLen && mSq > 0) {
    const scale = maxLen / Math.sqrt(mSq);
    out.x *= scale;
    out.y *= scale;
  }
  return out;
};

export const steering = {
  seek(agent, target, maxSpeed, out = { x: 0, y: 0 }) {
    const dx = target.x - agent.x;
    const dy = target.y - agent.y;
    const distSq = dx * dx + dy * dy;

    if (distSq === 0) {
      out.x = 0;
      out.y = 0;
      return out;
    }

    const inv = maxSpeed / Math.sqrt(distSq);
    out.x = dx * inv - (agent.vx || 0);
    out.y = dy * inv - (agent.vy || 0);
    return out;
  },

  // Flees when inside panicRadius; applies a braking force once at a safe distance.
  flee(agent, threat, maxSpeed, panicRadius = 160, out = { x: 0, y: 0 }) {
    const dx = agent.x - threat.x;
    const dy = agent.y - threat.y;
    const distSq = dx * dx + dy * dy;

    if (Number.isFinite(panicRadius) && distSq >= panicRadius * panicRadius) {
      out.x = -(agent.vx || 0) * 4;
      out.y = -(agent.vy || 0) * 4;
      return out;
    }

    if (distSq === 0) {
      out.x = maxSpeed;
      out.y = 0;
      return out;
    }

    const dist = Math.sqrt(distSq);
    const speed = Number.isFinite(panicRadius)
      ? maxSpeed * Math.min(1, (panicRadius - dist) / (panicRadius * 0.35))
      : maxSpeed;

    const inv = speed / dist;
    out.x = dx * inv - (agent.vx || 0);
    out.y = dy * inv - (agent.vy || 0);
    return out;
  },

  arrive(agent, target, maxSpeed, slowRadius = 100, out = { x: 0, y: 0 }) {
    const dx = target.x - agent.x;
    const dy = target.y - agent.y;
    const dist = Math.sqrt(dx * dx + dy * dy);

    if (dist < 0.001) {
      out.x = -(agent.vx || 0) * 4;
      out.y = -(agent.vy || 0) * 4;
      return out;
    }

    const speed = dist < slowRadius ? maxSpeed * (dist / slowRadius) : maxSpeed;
    const inv = speed / dist;
    out.x = dx * inv - (agent.vx || 0);
    out.y = dy * inv - (agent.vy || 0);
    return out;
  },

  pursue(agent, target, maxSpeed, maxPrediction = 0.5, out = { x: 0, y: 0 }) {
    const dx = target.x - agent.x;
    const dy = target.y - agent.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    const speed = Math.sqrt((agent.vx || 0) ** 2 + (agent.vy || 0) ** 2);
    const lookAhead = speed <= dist / maxPrediction ? maxPrediction : dist / (speed || 1);

    _targetScratch.x = target.x + (target.vx || 0) * lookAhead;
    _targetScratch.y = target.y + (target.vy || 0) * lookAhead;
    return steering.seek(agent, _targetScratch, maxSpeed, out);
  },

  orbit(agent, target, radius, maxSpeed, clockwise = true, out = { x: 0, y: 0 }) {
    const dx = agent.x - target.x;
    const dy = agent.y - target.y;
    const dist = Math.sqrt(dx * dx + dy * dy) || 1;

    const nx = dx / dist;
    const ny = dy / dist;

    const tx = clockwise ? -ny : ny;
    const ty = clockwise ? nx : -nx;

    const radialError = (radius - dist) / Math.max(1, radius);
    const vx = tx + nx * radialError * 1.5;
    const vy = ty + ny * radialError * 1.5;
    const len = Math.sqrt(vx * vx + vy * vy) || 1;

    out.x = (vx / len) * maxSpeed - (agent.vx || 0);
    out.y = (vy / len) * maxSpeed - (agent.vy || 0);
    return out;
  },

  // Smooth random patrolling using a forward circle projection.
  wander(agent, maxSpeed, { distance = 60, radius = 35, jitter = 0.35, rng = Math.random } = {}, out = { x: 0, y: 0 }) {
    agent._wanderAngle = (agent._wanderAngle || 0) + (rng() - 0.5) * 2 * jitter;

    const vx = agent.vx || 0;
    const vy = agent.vy || 0;
    const spd = Math.sqrt(vx * vx + vy * vy);
    const headingX = spd > 0.01 ? vx / spd : 1;
    const headingY = spd > 0.01 ? vy / spd : 0;

    const centerX = agent.x + headingX * distance;
    const centerY = agent.y + headingY * distance;
    _targetScratch.x = centerX + Math.cos(agent._wanderAngle) * radius;
    _targetScratch.y = centerY + Math.sin(agent._wanderAngle) * radius;

    return steering.seek(agent, _targetScratch, maxSpeed, out);
  },

  separate(agent, neighbors, desiredSeparation = 32, maxSpeed = 200, out = { x: 0, y: 0 }) {
    const sepSq = desiredSeparation * desiredSeparation;
    let sumX = 0;
    let sumY = 0;
    let count = 0;

    for (let i = 0; i < neighbors.length; i++) {
      const other = neighbors[i];
      if (other === agent) continue;
      const dx = agent.x - other.x;
      const dy = agent.y - other.y;
      const dSq = dx * dx + dy * dy;

      if (dSq > 0 && dSq < sepSq) {
        const d = Math.sqrt(dSq);
        sumX += (dx / d) / d;
        sumY += (dy / d) / d;
        count++;
      }
    }

    if (count === 0) {
      out.x = 0;
      out.y = 0;
      return out;
    }

    const len = Math.sqrt(sumX * sumX + sumY * sumY);
    if (len > 0) {
      out.x = (sumX / len) * maxSpeed - (agent.vx || 0);
      out.y = (sumY / len) * maxSpeed - (agent.vy || 0);
    } else {
      out.x = 0;
      out.y = 0;
    }
    return out;
  },

  flock(agent, neighbors, {
    neighborRadius = 70,
    separationRadius = 28,
    maxSpeed = 200,
    sepWeight = 1.6,
    alignWeight = 1.0,
    cohWeight = 0.8
  } = {}, out = { x: 0, y: 0 }) {
    const nSq = neighborRadius * neighborRadius;
    const sSq = separationRadius * separationRadius;

    let sepX = 0, sepY = 0, sepCount = 0;
    let aliX = 0, aliY = 0;
    let cohX = 0, cohY = 0;
    let count = 0;

    for (let i = 0; i < neighbors.length; i++) {
      const other = neighbors[i];
      if (other === agent) continue;

      const dx = agent.x - other.x;
      const dy = agent.y - other.y;
      const dSq = dx * dx + dy * dy;

      if (dSq > 0 && dSq < nSq) {
        aliX += other.vx || 0;
        aliY += other.vy || 0;
        cohX += other.x;
        cohY += other.y;
        count++;

        if (dSq < sSq) {
          const d = Math.sqrt(dSq);
          sepX += (dx / d) / d;
          sepY += (dy / d) / d;
          sepCount++;
        }
      }
    }

    out.x = 0;
    out.y = 0;

    if (sepCount > 0) {
      const len = Math.sqrt(sepX * sepX + sepY * sepY) || 1;
      out.x += ((sepX / len) * maxSpeed - (agent.vx || 0)) * sepWeight;
      out.y += ((sepY / len) * maxSpeed - (agent.vy || 0)) * sepWeight;
    }

    if (count > 0) {
      const aLen = Math.sqrt(aliX * aliX + aliY * aliY);
      if (aLen > 0) {
        out.x += ((aliX / aLen) * maxSpeed - (agent.vx || 0)) * alignWeight;
        out.y += ((aliY / aLen) * maxSpeed - (agent.vy || 0)) * alignWeight;
      }

      const cx = cohX / count - agent.x;
      const cy = cohY / count - agent.y;
      const cLen = Math.sqrt(cx * cx + cy * cy);
      if (cLen > 0) {
        out.x += ((cx / cLen) * maxSpeed - (agent.vx || 0)) * cohWeight;
        out.y += ((cy / cLen) * maxSpeed - (agent.vy || 0)) * cohWeight;
      }
    }

    return out;
  },

  applyForce(agent, force, maxForce, maxSpeed, dt) {
    const dtSec = dt / 1000;
    clampVec(force, maxForce);

    agent.vx = (agent.vx || 0) + force.x * dtSec;
    agent.vy = (agent.vy || 0) + force.y * dtSec;

    const spdSq = agent.vx * agent.vx + agent.vy * agent.vy;
    if (spdSq > maxSpeed * maxSpeed && spdSq > 0) {
      const scale = maxSpeed / Math.sqrt(spdSq);
      agent.vx *= scale;
      agent.vy *= scale;
    }

    agent.x += agent.vx * dtSec;
    agent.y += agent.vy * dtSec;
    return agent;
  }
};
</file>

<file path="core/random.js">
// Seeded PRNG (Mulberry32) for reproducible procedural generation and runs.
//
//   const rng = new Random('run-seed-42');
//   rng.next();          // [0, 1)
//   rng.range(5, 10);    // float in [5, 10)
//   rng.int(1, 6);       // integer in [1, 6]
//   rng.choice(items);   // random element

export class Random {
  constructor(seed = Date.now()) {
    this.setSeed(seed);
  }

  setSeed(seed) {
    if (typeof seed !== 'string' && !(typeof seed === 'number' && Number.isFinite(seed))) {
      throw new TypeError(`Random: seed must be a finite number or string, got ${seed}`);
    }
    const str = typeof seed === 'number' && Object.is(seed, -0) ? '-0' : String(seed);
    let h = 2166136261 >>> 0;
    for (let i = 0; i < str.length; i++) {
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    h ^= h >>> 16;
    h = Math.imul(h, 0x85ebca6b);
    h ^= h >>> 13;
    h = Math.imul(h, 0xc2b2ae35);
    h ^= h >>> 16;
    this.state = (h >>> 0) || 1;
    return this;
  }

  getState() {
    return this.state >>> 0;
  }

  setState(state) {
    if (typeof state !== 'number' || !Number.isFinite(state)) {
      throw new TypeError(`Random.setState: state must be a finite number, got ${state}`);
    }
    this.state = state >>> 0;
    return this;
  }

  // Returns a float in [0, 1).
  next() {
    let t = (this.state = (this.state + 0x6d2b79f5) >>> 0);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }

  range(min, max) {
    return min + this.next() * (max - min);
  }

  int(min, max) {
    return Math.floor(this.range(min, max + 1));
  }

  choice(array) {
    if (!Array.isArray(array) || array.length === 0) return undefined;
    return array[this.int(0, array.length - 1)];
  }
}

export const random = new Random();
</file>

<file path="core/vec2.js">
// 2D vector math. Instance methods mutate `this` in place and return `this` for chaining.
// Use clone() or the static helpers (Vec2.add, Vec2.sub) when you need a new vector.
//
//   const pos = new Vec2(10, 20);
//   pos.add(vel).limit(100);
//   const delta = Vec2.sub(target, pos);

export class Vec2 {
  constructor(x = 0, y = 0) {
    this.x = x;
    this.y = y;
  }

  set(x, y) {
    this.x = x;
    this.y = y;
    return this;
  }

  copy(v) {
    this.x = v.x;
    this.y = v.y;
    return this;
  }

  clone() {
    return new Vec2(this.x, this.y);
  }

  add(v) {
    this.x += v.x;
    this.y += v.y;
    return this;
  }

  sub(v) {
    this.x -= v.x;
    this.y -= v.y;
    return this;
  }

  mult(n) {
    this.x *= n;
    this.y *= n;
    return this;
  }

  dot(v) {
    return this.x * v.x + this.y * v.y;
  }

  magSq() {
    return this.x * this.x + this.y * this.y;
  }

  mag() {
    return Math.sqrt(this.x * this.x + this.y * this.y);
  }

  normalize() {
    const mSq = this.x * this.x + this.y * this.y;
    if (mSq > 0) {
      const inv = 1 / Math.sqrt(mSq);
      this.x *= inv;
      this.y *= inv;
    }
    return this;
  }

  limit(max) {
    const mSq = this.x * this.x + this.y * this.y;
    if (mSq > max * max && mSq > 0) {
      const scale = max / Math.sqrt(mSq);
      this.x *= scale;
      this.y *= scale;
    }
    return this;
  }

  distanceSq(v) {
    const dx = this.x - v.x;
    const dy = this.y - v.y;
    return dx * dx + dy * dy;
  }

  distance(v) {
    return Math.sqrt(this.distanceSq(v));
  }

  static add(a, b, out = new Vec2()) {
    return out.set(a.x + b.x, a.y + b.y);
  }

  static sub(a, b, out = new Vec2()) {
    return out.set(a.x - b.x, a.y - b.y);
  }

  static distanceSq(a, b) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return dx * dx + dy * dy;
  }
}
</file>

