<file path="core/events.js">
// Pub/sub event bus for decoupled communication between game systems.
//
//   const off = events.on('enemyKilled', (e) => addScore(e.points));
//   events.emit('enemyKilled', { points: 10 });
//   off(); // unsubscribe

export class EventEmitter {
  constructor() {
    this.listeners = new Map();
  }

  on(event, callback) {
    if (typeof callback !== 'function') {
      throw new TypeError('EventEmitter.on: callback must be a function');
    }
    let list = this.listeners.get(event);
    if (!list) {
      list = [];
      this.listeners.set(event, list);
    }
    list.push(callback);
    return () => this.off(event, callback);
  }

  once(event, callback) {
    const off = this.on(event, (data) => {
      off();
      callback(data);
    });
    return off;
  }

  off(event, callback) {
    const list = this.listeners.get(event);
    if (!list) return;
    const idx = list.indexOf(callback);
    if (idx !== -1) list.splice(idx, 1);
    if (list.length === 0) this.listeners.delete(event);
  }

  emit(event, data) {
    const list = this.listeners.get(event);
    if (!list || list.length === 0) return;
    const snapshot = list.slice();
    let firstError = null;
    for (let i = 0; i < snapshot.length; i++) {
      try {
        snapshot[i](data);
      } catch (err) {
        if (!firstError) firstError = err;
      }
    }
    if (firstError) throw firstError;
  }

  clear(event) {
    if (event !== undefined) this.listeners.delete(event);
    else this.listeners.clear();
  }
}

export const events = new EventEmitter();
</file>

<file path="core/loop.js">
// Fixed-timestep game loop.
// updateFn(dt) receives fixed step in milliseconds (default 16.67ms at 60Hz).
// renderFn(alpha) receives interpolation factor in [0, 1) for smooth rendering.
//
//   const loop = new GameLoop((dt) => update(dt), (alpha) => render(alpha));
//   loop.start();

export class GameLoop {
  constructor(updateFn, renderFn, targetFps = 60) {
    this.updateFn = updateFn;
    this.renderFn = renderFn;
    this.step = 1000 / targetFps;
    this.lastTime = 0;
    this.accumulator = 0;
    this.rafId = null;
    this.isRunning = false;

    this.fps = 0;
    this._frameCount = 0;
    this._lastFpsTime = 0;
  }

  start() {
    if (this.isRunning) return;
    this.isRunning = true;
    const now = performance.now();
    this.lastTime = now;
    this._lastFpsTime = now;
    this._frameCount = 0;
    this.rafId = requestAnimationFrame((time) => this.frame(time));
  }

  stop() {
    this.isRunning = false;
    if (this.rafId !== null) {
      cancelAnimationFrame(this.rafId);
      this.rafId = null;
    }
  }

  frame(currentTime) {
    if (!this.isRunning) return;

    let deltaTime = currentTime - this.lastTime;
    this.lastTime = currentTime;

    if (deltaTime > 250) deltaTime = 250;

    this.accumulator += deltaTime;

    while (this.accumulator >= this.step) {
      this.updateFn(this.step);
      this.accumulator -= this.step;
    }

    const alpha = this.accumulator / this.step;
    this.renderFn(alpha);

    this._frameCount++;
    if (currentTime - this._lastFpsTime >= 1000) {
      this.fps = this._frameCount;
      this._frameCount = 0;
      this._lastFpsTime = currentTime;
    }

    this.rafId = requestAnimationFrame((time) => this.frame(time));
  }
}
</file>

<file path="core/timer.js">
export class TimerManager {
  constructor() {
    this.timers = [];
    this._due = [];
    this._clearGen = 0;
  }

  add(durationMs, onComplete, onUpdate = null) {
    if (!(durationMs >= 0) || !Number.isFinite(durationMs)) {
      throw new RangeError('TimerManager.add: durationMs must be a finite number >= 0');
    }
    const entry = {
      duration: durationMs,
      elapsed: 0,
      onComplete,
      onUpdate,
      repeat: false,
      cancelled: false
    };
    this.timers.push(entry);
    return entry;
  }

  every(intervalMs, onTick) {
    if (!(intervalMs > 0) || !Number.isFinite(intervalMs)) {
      throw new RangeError('TimerManager.every: intervalMs must be a finite number > 0');
    }
    const entry = {
      duration: intervalMs,
      elapsed: 0,
      onComplete: onTick,
      onUpdate: null,
      repeat: true,
      cancelled: false
    };
    this.timers.push(entry);
    return entry;
  }

  cancel(entry) {
    if (!entry) return;
    entry.cancelled = true;
    const idx = this.timers.indexOf(entry);
    if (idx !== -1) {
      this.timers.splice(idx, 1);
    }
  }

  clear() {
    this.timers.length = 0;
    this._due.length = 0;
    this._clearGen++;
  }

  update(dt) {
    const list = this.timers;
    const due = this._due;
    due.length = 0;

    const initialLen = list.length;
    const startGen = this._clearGen;
    let writeIdx = 0;

    for (let i = 0; i < initialLen; i++) {
      const t = list[i];
      if (!t || t.cancelled) continue;

      t.elapsed += dt;

      if (t.onUpdate) {
        const progress = t.duration > 0 ? Math.min(t.elapsed / t.duration, 1) : 1;
        t.onUpdate(progress);
        if (this._clearGen !== startGen) return;
        if (t.cancelled) continue;
      }

      if (t.elapsed >= t.duration) {
        if (t.onComplete) due.push(t);
        if (t.repeat && !t.cancelled) {
          t.elapsed %= t.duration;
          list[writeIdx++] = t;
        }
      } else {
        list[writeIdx++] = t;
      }
    }

    for (let i = initialLen; i < list.length; i++) {
      if (!list[i].cancelled) {
        list[writeIdx++] = list[i];
      }
    }

    list.length = writeIdx;

    for (let i = 0; i < due.length; i++) {
      const t = due[i];
      if (!t.cancelled) {
        t.onComplete();
        if (this._clearGen !== startGen) break;
      }
    }
    due.length = 0;
  }
}

export const timer = new TimerManager();
</file>

