const enemies = Array.from({ length: 7 }, (_, i) => ({
  id: i + 1,
  x: 80 + ((i * 73) % 400),
  y: 50 + ((i * 97) % 250),
  vx: (i % 2 === 0 ? 1 : -1) * 45,
  vy: (i % 3 === 0 ? 1 : -1) * 45,
  r: 7
}));

window.addEventListener('keydown', (e) => { keys[e.code] = true; });
window.addEventListener('keyup', (e) => { keys[e.code] = false; });

canvas.addEventListener('mousedown', () => {
  player.x = input.mouse.x;
  player.y = input.mouse.y;
  draggingPlayer = true;
});
window.addEventListener('mouseup', () => { draggingPlayer = false; });

canvas.addEventListener('mousemove', () => {
  mouse.x = input.mouse.x;
  mouse.y = input.mouse.y;
  if (draggingPlayer) {
    player.x = mouse.x;
    player.y = mouse.y;
  }
});

document.getElementById('btn360').addEventListener('click', () => {
  rngFov.value = Number(rngFov.value) >= 360 ? 90 : 360;
});

document.getElementById('btnRandomWalls').addEventListener('click', () => {
  obstacles = [
    { x: 160 + Math.random() * 80, y: 40 + Math.random() * 60, w: 50, h: 100 },
    { x: 240 + Math.random() * 90, y: 190 + Math.random() * 60, w: 110, h: 45 },
    { x: 340 + Math.random() * 80, y: 90 + Math.random() * 120, r: 28 },
    { x: 90 + Math.random() * 70, y: 220 + Math.random() * 70, r: 24 }
  ];
});

let lastTime = performance.now();

const loop = (now) => {
  const dt = Math.min(50, now - lastTime) / 1000;
  lastTime = now;

  const fovDeg = Number(rngFov.value);
  const fovRad = (fovDeg * Math.PI) / 180;
  const maxRange = Number(rngRange.value);
  const rayCount = Number(rngRays.value);

  document.getElementById('valFov').textContent = fovDeg;
  document.getElementById('valRange').textContent = maxRange;
  document.getElementById('valRays').textContent = rayCount;

  // WASD Player Movement
  let mx = (keys.KeyD || keys.ArrowRight ? 1 : 0) - (keys.KeyA || keys.ArrowLeft ? 1 : 0);
  let my = (keys.KeyS || keys.ArrowDown ? 1 : 0) - (keys.KeyW || keys.ArrowUp ? 1 : 0);
  if (mx !== 0 || my !== 0) {
    const len = Math.hypot(mx, my);
    player.x = Math.max(12, Math.min(canvas.width - 12, player.x + (mx / len) * player.speed * dt));
    player.y = Math.max(12, Math.min(canvas.height - 12, player.y + (my / len) * player.speed * dt));
  }

  player.angle = Math.atan2(mouse.y - player.y, mouse.x - player.x);
  sentry.angle += dt * 0.7;

  // Patrol enemies
  for (const e of enemies) {
    e.x += e.vx * dt;
    e.y += e.vy * dt;
    if (e.x < 15 || e.x > canvas.width - 15) e.vx *= -1;
    if (e.y < 15 || e.y > canvas.height - 15) e.vy *= -1;
  }

  // Compute Player Visibility Polygon & filter visible enemies
  lineOfSight.castVisionPolygon(player, player.angle, fovRad, maxRange, rayCount, obstacles, visionPoly);
  lineOfSight.filterVisible(player, player.angle, enemies, maxRange, fovRad, obstacles, visibleTargets);

  // Check if AI Sentry spots Player
  const sentrySpotsPlayer = chkSentry.checked && lineOfSight.inVisionCone(
    sentry,
    sentry.angle,
    player,
    sentry.range,
    sentry.fov,
    obstacles
  );

  // Direct aim raycast from player toward mouse
  const aimEndX = player.x + Math.cos(player.angle) * maxRange;
  const aimEndY = player.y + Math.sin(player.angle) * maxRange;
  const aimHit = lineOfSight.raycast(player.x, player.y, aimEndX, aimEndY, obstacles, laserHit);

  // Render Fog-of-War background
  ctx.fillStyle = '#06080e';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Draw Player Vision Polygon
  if (visionPoly.length > 1) {
    ctx.fillStyle = 'rgba(243, 234, 211, 0.14)';
    ctx.beginPath();
    if (fovDeg < 360) ctx.moveTo(player.x, player.y);
    else ctx.moveTo(visionPoly[0].x, visionPoly[0].y);
    for (let i = 0; i < visionPoly.length; i++) {
      ctx.lineTo(visionPoly[i].x, visionPoly[i].y);
    }
    ctx.closePath();
    ctx.fill();

    if (chkRays.checked) {
      ctx.strokeStyle = 'rgba(243, 234, 211, 0.18)';
      ctx.lineWidth = 1;
      for (let i = 0; i < visionPoly.length; i++) {
        ctx.beginPath();
        ctx.moveTo(player.x, player.y);
        ctx.lineTo(visionPoly[i].x, visionPoly[i].y);
        ctx.stroke();
      }
    }
  }

  // Draw AI Sentry Cone
  if (chkSentry.checked) {
    ctx.fillStyle = sentrySpotsPlayer ? 'rgba(201, 107, 107, 0.28)' : 'rgba(217, 185, 120, 0.09)';
    ctx.beginPath();
    ctx.moveTo(sentry.x, sentry.y);
    ctx.arc(sentry.x, sentry.y, sentry.range, sentry.angle - sentry.fov / 2, sentry.angle + sentry.fov / 2);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#d9b978';
    ctx.beginPath();
    ctx.arc(sentry.x, sentry.y, 7, 0, Math.PI * 2);
    ctx.fill();
  }

  // Draw Obstacles
  ctx.fillStyle = '#182236';
  ctx.strokeStyle = '#233452';
  ctx.lineWidth = 2;
  for (const obs of obstacles) {
    if (obs.r !== undefined) {
      ctx.beginPath();
      ctx.arc(obs.x, obs.y, obs.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    } else {
      ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
      ctx.strokeRect(obs.x, obs.y, obs.w, obs.h);
    }
  }

  // Draw Enemies (Full highlight when in Player LOS, dim radar outline when hidden in fog/behind wall)
  for (const e of enemies) {
    const isVisible = visibleTargets.includes(e);
    if (isVisible) {
      ctx.fillStyle = '#c96b6b';
      ctx.beginPath();
      ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
      ctx.fill();
    } else {
      ctx.strokeStyle = '#233452';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(e.x, e.y, e.r - 1, 0, Math.PI * 2);
      ctx.stroke();
    }
  }

  // Draw Player center aim laser
  ctx.strokeStyle = '#d9b978';
  ctx.setLineDash([4, 4]);
  ctx.beginPath();
  ctx.moveTo(player.x, player.y);
  ctx.lineTo(aimHit ? aimHit.x : aimEndX, aimHit ? aimHit.y : aimEndY);
  ctx.stroke();
  ctx.setLineDash([]);

  if (aimHit) {
    ctx.fillStyle = '#d9b978';
    ctx.beginPath();
    ctx.arc(aimHit.x, aimHit.y, 3.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // Draw Player
  ctx.fillStyle = '#f3ead3';
  ctx.beginPath();
  ctx.arc(player.x, player.y, 8, 0, Math.PI * 2);
  ctx.fill();

  out.textContent =
    `Player Pos: (${player.x.toFixed(0)}, ${player.y.toFixed(0)}) [Move with WASD or Click-Drag, Aim with Mouse]\n` +
    `Enemies Revealed in Player LOS: ${visibleTargets.length} / ${enemies.length} | AI Sentry Alerted: ${sentrySpotsPlayer}`;

  requestAnimationFrame(loop);
};

requestAnimationFrame(loop);
</file>

<file path="demo/ai/js/steering-demo.js">
import { steering } from '@ai/steering.js';
import { input } from '@core/input.js';

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const out = document.getElementById('output');

let mode = 'flee';
const target = { x: canvas.width / 2, y: canvas.height / 2, vx: 0, vy: 0 };
const force = { x: 0, y: 0 };
const sepForce = { x: 0, y: 0 };

const rngRadius = document.getElementById('rngRadius');
const rngCount = document.getElementById('rngCount');
const rngSpeed = document.getElementById('rngSpeed');
const rngForce = document.getElementById('rngForce');
const rngSep = document.getElementById('rngSep');
const chkVectors = document.getElementById('chkVectors');
const chkBounce = document.getElementById('chkBounce');

const agents = Array.from({ length: 160 }, () => ({
  x: Math.random() * (canvas.width - 40) + 20,
  y: Math.random() * (canvas.height - 40) + 20,
  vx: 0,
  vy: 0,
  lastFx: 0,
  lastFy: 0
}));

canvas.addEventListener('mousemove', () => {
  target.x = input.mouse.x;
  target.y = input.mouse.y;
});

document.querySelectorAll('#modeBar button').forEach((btn) => {
  btn.addEventListener('click', () => {
    mode = btn.dataset.mode;
    document.querySelectorAll('#modeBar button').forEach((b) => b.classList.toggle('active', b === btn));
  });
});

let lastTime = performance.now();

const loop = (now) => {
  const dt = Math.min(50, now - lastTime);
  lastTime = now;

  const radius = Number(rngRadius.value);
  const count = Number(rngCount.value);
  const maxSpeed = Number(rngSpeed.value);
  const maxForce = Number(rngForce.value);
  const sepWeight = Number(rngSep.value);

  document.getElementById('valRadius').textContent = radius;
  document.getElementById('valCount').textContent = count;
  document.getElementById('valSpeed').textContent = maxSpeed;
  document.getElementById('valForce').textContent = maxForce;
  document.getElementById('valSep').textContent = sepWeight.toFixed(1);

  const activeSlice = agents.slice(0, count);
  let panickedCount = 0;

  for (let i = 0; i < count; i++) {
    const a = activeSlice[i];

    if (mode === 'flee') {
      const dSq = (a.x - target.x) ** 2 + (a.y - target.y) ** 2;
      if (dSq < radius * radius) panickedCount++;
      steering.flee(a, target, maxSpeed, radius, force);
    } else if (mode === 'seek') {
      steering.seek(a, target, maxSpeed, force);
    } else if (mode === 'orbit') {
      steering.orbit(a, target, radius, maxSpeed, i % 2 === 0, force);
    } else if (mode === 'arrive') {
      steering.arrive(a, target, maxSpeed, radius, force);
    } else if (mode === 'wander') {
      steering.wander(a, maxSpeed, { distance: 55, radius: 30, jitter: 0.3 }, force);
    } else {
      steering.flock(a, activeSlice, {
        neighborRadius: radius,
        separationRadius: 26,
        maxSpeed,
        sepWeight
      }, force);
    }

    if (mode !== 'flock' && sepWeight > 0) {
      steering.separate(a, activeSlice, 24, maxSpeed, sepForce);
      force.x += sepForce.x * sepWeight;
      force.y += sepForce.y * sepWeight;
    }

    a.lastFx = force.x;
    a.lastFy = force.y;
    steering.applyForce(a, force, maxForce, maxSpeed, dt);

    if (chkBounce.checked) {
      const pad = 10;
      if (a.x < pad) { a.x = pad; a.vx *= -0.6; }
      if (a.x > canvas.width - pad) { a.x = canvas.width - pad; a.vx *= -0.6; }
      if (a.y < pad) { a.y = pad; a.vy *= -0.6; }
      if (a.y > canvas.height - pad) { a.y = canvas.height - pad; a.vy *= -0.6; }
    } else {
      if (a.x < 0) a.x += canvas.width;
      if (a.x > canvas.width) a.x -= canvas.width;
      if (a.y < 0) a.y += canvas.height;
      if (a.y > canvas.height) a.y -= canvas.height;
    }
  }

  ctx.fillStyle = '#080b12';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  if (chkVectors.checked && (mode === 'flee' || mode === 'orbit' || mode === 'arrive')) {
    ctx.strokeStyle = mode === 'flee' ? '#c96b6b' : '#233452';
    ctx.setLineDash([5, 5]);
    ctx.beginPath();
    ctx.arc(target.x, target.y, radius, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  if (mode !== 'wander' && mode !== 'flock') {
    ctx.fillStyle = mode === 'flee' ? '#c96b6b' : '#d9b978';
    ctx.beginPath();
    ctx.arc(target.x, target.y, 6, 0, Math.PI * 2);
    ctx.fill();
  }

  for (let i = 0; i < count; i++) {
    const a = activeSlice[i];
    const spd = Math.hypot(a.vx, a.vy);
    const angle = spd > 1 ? Math.atan2(a.vy, a.vx) : 0;

    if (chkVectors.checked && spd > 2) {
      ctx.strokeStyle = '#233452';
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(a.x + a.vx * 0.15, a.y + a.vy * 0.15);
      ctx.stroke();
    }

    const isFleeing = mode === 'flee' && (a.x - target.x) ** 2 + (a.y - target.y) ** 2 < radius * radius;
    ctx.fillStyle = isFleeing ? '#c96b6b' : '#f3ead3';

    ctx.save();
    ctx.translate(a.x, a.y);
    ctx.rotate(angle);
    ctx.beginPath();
    ctx.moveTo(7, 0);
    ctx.lineTo(-5, -4);
    ctx.lineTo(-5, 4);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  out.textContent =
    `Mode: ${mode.toUpperCase()} | Active Agents: ${count} | Radius: ${radius}px\n` +
    (mode === 'flee'
      ? `Agents inside Panic Radius: ${panickedCount} (Agents outside ${radius}px automatically brake to a stop)`
      : `Move mouse over canvas to steer agents. Adjust sliders above to tune forces live.`);

  requestAnimationFrame(loop);
};

requestAnimationFrame(loop);
</file>

