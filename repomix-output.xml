<file path="demo/module-docs.css">
:root {
  --bg: #080b12;
  --panel: #101624;
  --panel-alt: #182236;
  --border: #233452;
  --border-subtle: rgba(35, 52, 82, 0.65);
  --text: #e6e1d6;
  --muted: #8e9bb0;
  --accent: #f3ead3;
  --accent-dim: rgba(243, 234, 211, 0.08);
  --pink: #c96b6b;
  --amber: #d9b978;
  --blue: #78b0d9;
  --green: #6bc98f;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

* {
  box-sizing: border-box;
  scrollbar-width: thin;
  scrollbar-color: var(--border) var(--bg);
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
  border: 2px solid var(--bg);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

body {
  margin: 0;
  padding: 0 0 4.5rem;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

@keyframes gkFadeUp {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.gk-fade-in {
  animation: gkFadeUp 0.28s var(--ease-out) both;
}

/* Sticky Top Navigation */
.gk-topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8, 11, 18, 0.88);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.gk-topbar-inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0.75rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.gk-brand {
  color: var(--accent);
  font-weight: 700;
  font-size: 1.05rem;
  text-decoration: none;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.gk-brand span {
  font-family: monospace;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--amber);
  background: rgba(217, 185, 120, 0.12);
  border: 1px solid rgba(217, 185, 120, 0.3);
  padding: 0.1rem 0.4rem;
  border-radius: 4px;
}

.gk-pill-nav {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.gk-pill-nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.85rem;
  padding: 0.38rem 0.8rem;
  border-radius: 6px;
  border: 1px solid transparent;
  transition: color 0.18s var(--ease-out), background 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
}

.gk-pill-nav a:hover {
  color: var(--accent);
  background: var(--panel);
  border-color: var(--border);
}

.gk-pill-nav a.active {
  color: #080b12;
  background: var(--accent);
  border-color: var(--accent);
  font-weight: 600;
}

.gk-container {
  max-width: 1120px;
  margin: 0 auto;
  padding: 1.75rem 1.5rem 0;
}

/* Homepage Showcase Banner */
.gk-showcase-banner {
  background: linear-gradient(135deg, var(--panel) 0%, #131c2e 100%);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.4rem 1.6rem;
  margin-bottom: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  transition: border-color 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
}

.gk-showcase-banner:hover {
  border-color: rgba(243, 234, 211, 0.4);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.gk-badge-amber {
  display: inline-block;
  font-family: monospace;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--amber);
  margin-bottom: 0.3rem;
}

.gk-showcase-banner h1 {
  margin: 0 0 0.25rem;
  font-size: 1.35rem;
  color: var(--accent);
}

.gk-showcase-banner p {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.gk-cta-btn {
  display: inline-flex;
  align-items: center;
  background: var(--accent);
  color: #080b12;
  text-decoration: none;
  font-weight: 700;
  font-size: 0.88rem;
  padding: 0.65rem 1.15rem;
  border-radius: 6px;
  border: 1px solid var(--accent);
  white-space: nowrap;
  transition: transform 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out), opacity 0.18s var(--ease-out);
}

.gk-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(243, 234, 211, 0.18);
}

/* Homepage Filter & Search Bar */
.gk-hub-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.85rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.gk-filter-pills {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.gk-filter-pills button {
  background: var(--panel);
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 0.38rem 0.72rem;
  border-radius: 6px;
  font-size: 0.82rem;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  cursor: pointer;
  transition: all 0.16s var(--ease-out);
}

.gk-filter-pills button span {
  font-family: monospace;
  font-size: 0.72rem;
  opacity: 0.75;
}

.gk-filter-pills button:hover {
  color: var(--accent);
  border-color: var(--accent);
}

.gk-filter-pills button.active {
  background: var(--accent);
  color: #080b12;
  border-color: var(--accent);
  font-weight: 700;
}

.gk-search-input {
  width: 280px;
  max-width: 100%;
  background: var(--panel);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.45rem 0.75rem;
  border-radius: 6px;
  font-size: 0.85rem;
  outline: none;
  transition: border-color 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
}

.gk-search-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-dim);
}

/* Homepage Clean List Layout */
.gk-module-groups {
  display: flex;
  flex-direction: column;
